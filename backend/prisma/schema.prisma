generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id           Int    @id @default(autoincrement())
  name         String
  email        String @unique
  passwordHash String
  tokenVersion Int    @default(0)
  role         Role   @default(EMPLOYEE)

  teamId Int?
  team   Team? @relation(fields: [teamId], references: [id])

  managerId Int?
  manager   User?  @relation("Reporting", fields: [managerId], references: [id])
  reports   User[] @relation("Reporting")

  requests  LeaveRequest[] @relation("EmployeeRequests")
  decisions LeaveRequest[] @relation("ManagerDecisions")
  balances  LeaveBalance[]

  createdAt DateTime @default(now())
}

model Team {
  id      Int    @id @default(autoincrement())
  name    String @unique
  members User[]
}

model LeaveType {
  id              Int    @id @default(autoincrement())
  name            String @unique
  yearlyAllowance Int

  requests LeaveRequest[]
  balances LeaveBalance[]
}

model LeaveBalance {
  id          Int @id @default(autoincrement())
  userId      Int
  leaveTypeId Int
  year        Int
  adjustment  Int @default(0)

  user      User      @relation(fields: [userId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([userId, leaveTypeId, year])
}

model LeaveRequest {
  id          Int @id @default(autoincrement())
  userId      Int
  leaveTypeId Int

  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String
  days      Int

  status      LeaveStatus @default(PENDING)
  decidedById Int?

  user      User      @relation("EmployeeRequests", fields: [userId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  decidedBy User?     @relation("ManagerDecisions", fields: [decidedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startDate, endDate])
  @@index([status])
}

model PublicHoliday {
  id   Int      @id @default(autoincrement())
  name String
  date DateTime @unique @db.Date
}

model AppSettings {
  id                Int @id @default(1)
  minimumNoticeDays Int @default(2)
  maxTeamMembersOff Int @default(2)
}

model PendingSignup {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  name              String
  passwordHash      String
  otpHash           String
  expiresAt         DateTime
  resendAvailableAt DateTime
  attempts          Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([expiresAt])
}

model PasswordReset {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  otpHash           String
  expiresAt         DateTime
  resendAvailableAt DateTime
  attempts          Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([expiresAt])
}